# Session/token signing key (64 hex chars) and web-installer upgrade key
$wgSecretKey = "CHANGE_ME";
$wgUpgradeKey = "CHANGE_ME";

# Cloudflare R2 credentials + account endpoint (Extension:AWS)
$wgAWSCredentials = [
	'key'    => 'CHANGE_ME',
	'secret' => 'CHANGE_ME',
	'region' => 'auto',
];
$wgFileBackends['s3']['endpoint'] = 'https://ACCOUNT_ID.r2.cloudflarestorage.com';
