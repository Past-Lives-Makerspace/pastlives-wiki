# Machine-local secrets for wiki.pastlives.space — never committed to git.
#
# Live location on the Hetzner VPS: /var/www/wiki.pastlives.space/secrets.php
# (outside the webroot, owned by wiki_pastlives_space, mode 0600).
# LocalSettings.php require_once's this file before anything else.

# Protect against web entry
